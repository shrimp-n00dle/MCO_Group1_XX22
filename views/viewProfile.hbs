{{> nav title="Garnet: A Hidden Gem" navBarStyle="home" username=sessionUser}}

<div class="bodyContainer">
    <div class="profileContainer">
        <div class="profileHead">
            <img src="{{profile.banner}}" class="profileHeadBanner">
            <img src="{{profile.profilePicture}}" class="profileHeadAvatar">
            <h1 class="profileUsername"> {{profile.username}} </h1>
            <p class="profileStatus"> <i>Employment Status: </i>     {{profile.employmentStatus}} </p>
            <p class="profileBio"> {{profile.bio}} </p> 

            <div class="profileHeadButtons">
                {{#unless (matchString sessionUser profile.username)}}
                <a href="/message/{{profile._id}}"><button>Message</button></a>
                {{/unless}}
                {{#if followingThisUser}}
                    <button onclick="Follow('{{profile._id}}')">Unfollow</button>
                {{else}}
                    <button onclick="Follow('{{profile._id}}')">Follow</button>
                {{/if}}
                {{#if (matchString sessionUser profile.username)}}
                <a href="/editProfile" class="profileEditButton"><img src="/img/editButton.png"></a>
                {{/if}}
            </div>

            <p class="profileGenres"><i>Game genres:</i> {{interestedGameGenres}}</p>
            <p class="profileFollowerCount">{{profile.followerCount}} Followers</p>

        </div>
    </div>
    {{#each posts}}
        {{> postPartial post=this sessionUser=@root.sessionUser}}
        {{else}}
            <div class="postContainer postBody">
                <p>No posts yet.</p>
            </div>
    {{/each}}
</div>

<script src="/js/following.js"></script>