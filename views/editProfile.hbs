{{> nav title="Garnet: A Hidden Gem" navBarStyle="home" username=sessionUser}}
<div class="bodyContainer editBodyContainer">
    <div class="profileContainer" style="grid-column: 1 / span 1; grid-row: 1 / span 1;">
        <div class="profileHead">
            <img src="{{profile.banner}}" class="profileHeadBanner">
            <img src="{{profile.profilePicture}}" class="profileHeadAvatar">
            <h1 class="profileUsername"> {{profile.username}} </h1>
            <p class="profileStatus"> <i>Employment Status: </i>     {{profile.employmentStatus}} </p>
            <p class="profileBio"> {{profile.bio}} </p> 

            <div class="profileHeadButtons">
                <a href=""><button>Message</button></a>
                <button>Follow</button>
            </div>

            <p class="profileGenres"><i>Game genres:</i> {{interestedGameGenres}}</p>
            <p class="profileFollowerCount">{{profile.followerCount}} Followers</p>
        </div>
    </div>

    <!-- POP-UP FOR UPDATES -->
    <div id="successPopUp" class="contentCard-light successPopUp hiddenPopUp">
        <p>Updated.</p>
    </div>

    <div class="contentCard-light profileEditCard" id="editProfileFormContainer">
        <h2>Edit Profile Details</h2>
        
        <form class="editProfileForm" id="EditProfileForm" method="post">
            {{!-- Username --}}
            <label for="changePfp" class="formLabel">Username:</label>
            <p><i>How should others call you?</i></p>
            <input type="text" id="changeUsername" name="username" class="formInput">
            {{!-- PFP --}}
            <label for="changePfp" class="formLabel">Profile Picture:</label>
            <p><i>Input a link to an image.</i></p>
            <input type="text" id="changePfp" name="profilePicture" class="formInput">
            {{!-- Banner --}}
            <label for="changeBaner" class="formLabel">Banner Picture:</label>
            <p><i>Input a link to an image.</i></p>
            <input type="text" id="changeBaner" name="banner" class="formInput">
            {{!-- Bio --}}
            <label for="changeBio" class="formLabel">Bio:</label>
            <p><i>Say something about yourself!</i></p>
            <textarea id="changeBio" name="bio"></textarea>
            {{!-- Employment status --}}
            <label for="changeEmployment" class="formLabel">Employment Status:</label>
            <p><i>Let others kow if you're available.</i></p>
            <select id="changeEmployment" name="employmentStatus">
                <option value="Keep current">Keep current</option>
                <option value="FREELANCE">Freelance</option>
                <option value="PART-TIME">Part-Time</option>
                <option value="FULL-TIME">Full-Time</option>
                <option value="NOT AVAILABLE">Not Available</option>
                <option value="HIATUS">Hiatus</option>
            </select>
            {{!-- Genres --}}
            <label for="changeGenres" class="formLabel">Game Genres:</label>
            <p><i>What game genres are you interested in? (Separate with commas.)</i></p>
            <input type="text" id="changeGameGenres" name="interestedGameGenres" class="formInput">

            <button type="submit" class="genButton-red">Update</button>
        </form>
        <button class="genButton-white" style="float: right; width: 50%;" onclick="ToggleForm()">Change Account Details</button>
    </div>

    <div class="contentCard-light profileEditCard hiddenPopUp" id="editAccountFormContainer">
        <h2>Change Account Details</h2>
        <p><b>These details are associated with your log-in information.</b></p>
        
        <form class="editProfileForm" id="EditAccountForm" method="post">
            {{!-- First Name --}}
            <label for="changeFirstName" class="formLabel">First Name:</label>
            <input type="text" id="changeFirstName" name="firstName" class="formInput">
            {{!-- Last Name --}}
            <label for="changeLastName" class="formLabel">Last Name:</label>
            <input type="text" id="changeLastName" name="lastName" class="formInput">
            {{!-- Email --}}
            <label for="changeEmail" class="formLabel">Email:</label>
            <input type="text" id="changeEmail" name="email" class="formInput">
            {{!-- Password --}}
            <label for="changePass" class="formLabel">Password:</label>
            <input type="text" id="changePass" name="password" class="formInput">

            <button type="submit" class="genButton-red">Update</button>
        </form>
        <button class="genButton-white" style="float: right; width: 50%;" onclick="ToggleForm()">Edit Profile Details</button>

        <button class="genButton-white" style="float: left; width: 30%;" onclick="ValidateAccountDeletion()">Delete Account</button>
    </div>
</div>

<script src="/js/editProfile.js"></script>