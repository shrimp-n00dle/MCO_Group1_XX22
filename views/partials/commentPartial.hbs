        <img src="{{comment.commentOwner.profilePicture}}">
        <a href="/viewProfile/{{comment.commentOwner.username}}"><h3>{{post.commentOwner.username}}</h3></a>
    </div>

    <div class="commentBody">
        <p> {{comment.body}} </p>

        <div class="commentFooter">
            <p class="commentLikeCount" name="likeCount">{{comment.likeCount}}</p>
            <button class="genButton-red" onclick="ToggleLike()">Like</button></a>
        </div>
    </div>
</div>
