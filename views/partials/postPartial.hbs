<div class="postContainer">
    <div class="postHeader">
        <img src="{{post.postOwner.profilePicture}}" class="postProfilePicture">
        <a href="/viewProfile/{{post.postOwner.username}}"><h3>{{post.postOwner.username}}</h3></a>
    </div>

    <div class="postBody">
        {{#if post.postTitle}}
            <h3><a href="viewPost/{{post._id}}" style="color: #4b2427; font-family:Expose;">{{post.postTitle}}</a></h3>
        {{/if}}
        <p>{{post.postBody}}</p>

        <div class="postImage">
            {{#if post.mediaFile}}
                <img src="{{post.mediaFile}}">
            {{/if}}
        </div>
    </div>

    <div class="postFooter">
        <p class="postLikeCount" id="likeCount">{{post.likeCount}}</p>
        <button class="postFooterButton" onclick="ToggleLike('{{post._id}}')"><img src="/img/likeIcon.png"></button>
        <p class="postCommentCount">{{post.commentCount}}</p>
        <button class="postFooterButton" onclick="ToggleComment('{{post._id}}')"><img src="/img/commentIcon.png"></button>
        {{#if (matchString sessionUser post.postOwner.username)}}
            <a href="/viewPost/{{post._id}}/edit" class="postFooterButton" style="margin-left: auto;"><img src="/img/editButton.png" style="border-radius: 100px;"></a>
        {{/if}}
    </div>

    {{!-- {{#if post.replyList}}
    <div class="postCommentContainer">
        <div class="commentHeader">
            <img src="{{post.commentPfp}}">
            <a href="/viewProfile/{{post.commentUser}}"><h3>{{post.commentUser}}</h3></a>
        </div>

        <div class="commentBody">
            <p> {{post.commentBody}} </p>

            <div class="commentFooter">
                <p class="commentLikeCount">{{post.commentLikes}}</p>
                <a href="">Like</a>
            </div>
        </div>
    </div>
    {{/if}} --}}
</div>