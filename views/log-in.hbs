{{> nav title="Garnet: A Hidden Gem" navBarStyle="register"}}

{{> sideLogo}}

{{!-- FORM --}}
<div class="welcomeDescContainer">
    <div class="welcomeDesc">
		<h1> GARNET </h1>
		<h3><i> Looking for a hidden gem? </i></h3>
	</div>

    <div class="contentCard-light registerCard" style="top: 12vh; right: 9vw">
        <p class="formSection">Enter account details:</p>
        <form id="logInForm" method="post">
            <!-- Email and pass -->
            <label for="email" class="formLabel">Email: </label> 
            <input type="Email"     id="email"    name="email" class="formInput" required> 
            <label for="password" class="formLabel">Password: </label> 
            <input type="password"  id="password" name="password" class="formInput" required>
            
            <button type="submit" class="regLogButton welcomeLogIn">Log In</button>
        </form>
    </div>

    <!-- POP-UP FOR INVALID USERNAME & EMAIL -->
    <div id="invalidPopUp" class="contentCard-light invalidCard hiddenPopUp">
        <p><b>Invalid log-in.</b></p>
    </div>
</div>

<script src="/js/log-in.js"></script>