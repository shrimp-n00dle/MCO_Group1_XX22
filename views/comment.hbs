{{> nav title="Garnet: A Hidden Gem" navBarStyle="home" username=sessionUser}}
<div class="bodyContainer">
    {{> searchSidebar}}
    <div id="allPosts">
    {{#each posts}}
        {{> postPartial post=this sessionUser=@root.sessionUser}}
        {{else}}
            <div class="contentCard-light">
                <p>Nothing to see!</p>
            </div>
    {{/each}}
    </div>

    <div class="contentCard-dark commentFormContainer">
        <h3>Comment</h3>

        <form id ="commentForm" method="post" class="commentForm">
            <input id="commentHead" class="hiddenPopUp" name="postID" value="{{postId}}"/>

            <textarea id="comentContent" name="commentBody" required></textarea>

            <button type="submit" class="genButton-red" style="float: right;">Post</button>
        </form>
    </div>

    <div class="sidebar hiddenPopUp" style="grid-column: 3 / span 1;" id="commentPopUp">
        <p>Something went wrong.</p>
    </div>
</div>

<script src="/js/commenting.js"></script>